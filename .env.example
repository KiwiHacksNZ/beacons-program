PORT=3000
NODE_ENV=production

# Dedicated NocoDB connection. Never place these values in the public site.
NOCODB_URL=https://your-nocodb-instance.com
NOCODB_API_TOKEN=your_xc_token_here
NOCODB_PROJECT_ID=p_xxxxxx

# Loops API key for sending transactional emails
LOOPS_API_KEY=your_loops_key_here

# Public HTTPS origin used to generate program-specific Fillout and leaderboard URLs.
PUBLIC_BACKEND_URL=https://beacons-api.example.com

# Exact production browser origin(s) allowed to submit admin forms.
# For local development, replace this with the exact local admin origin.
ADMIN_ORIGINS=https://beacons-api.example.com

# Long independently generated secret for the scheduled database health check.
HEALTHCHECK_SECRET=replace-with-a-long-random-secret

# Comma-separated production browser origins allowed to call the public endpoint.
# Add local origins only in a local development environment.
PUBLIC_SITE_ORIGINS=https://beacons.kiwihacks.com

# Backend cache duration for public leaderboard reads (1–300 seconds).
# Accepted signups force an immediate refresh.
LEADERBOARD_CACHE_TTL_MS=30000

# Optional display heading for the private dashboard.
ADMIN_TITLE=KiwiHacks Beacons

# Temporary diagnostics. Logs never include secrets or attendee personal data.
DEBUG_LOGS=false
