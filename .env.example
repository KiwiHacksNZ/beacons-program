PORT=3000
NODE_ENV=production

# Dedicated Beacons Supabase project. Never place either value in the public site.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Public HTTPS origin used to generate program-specific Fillout and leaderboard URLs.
PUBLIC_BACKEND_URL=https://beacons-api.example.com

# Long independently generated secret for the scheduled database health check.
HEALTHCHECK_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the public endpoint.
PUBLIC_SITE_ORIGINS=https://beacons.kiwihacks.com,http://localhost:8080

# Optional display heading for the private dashboard.
ADMIN_TITLE=KiwiHacks Beacons
